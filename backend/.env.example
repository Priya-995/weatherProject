# Groq LLM Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# PostgreSQL Database URL (asyncpg driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weathergpt

# External Weather Providers
OPEN_METEO_TIMEOUT_SECONDS=12
IMD_API_BASE_URL=https://mausam.imd.gov.in
NDMA_SACHET_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/FetchAllAlertDetails

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
