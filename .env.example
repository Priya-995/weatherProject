# GROQ_API_KEY: Required for WeatherGPT AI Assistant (Groq LLM provider).
# Configure in .env locally or in AI Studio Secrets on the server.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_MODEL="openai/gpt-oss-20b"

# DATABASE_URL: PostgreSQL connection string for persistent chat history.
# Example: postgresql://postgres:postgres@localhost:5432/weathergpt
DATABASE_URL=""

# FASTAPI_URL: Optional URL of the standalone Python FastAPI backend (e.g. http://127.0.0.1:8000).
# When set, Express proxies /api/* calls directly to the Python FastAPI + LangChain backend.
FASTAPI_URL=""

# FLOOD_SERVICE_URL: Optional URL of the dedicated Python FastAPI Flood ML microservice (e.g. http://127.0.0.1:8001).
FLOOD_SERVICE_URL="http://127.0.0.1:8001"

# IMD_API_BASE_URL: Optional India Meteorological Department endpoint override.
IMD_API_BASE_URL="https://mausam.imd.gov.in"

# GEMINI_API_KEY: Reserved by runtime environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform JavaScript & Places API key.
VITE_GOOGLE_MAPS_API_KEY=""
